# templates/prometheus.yml.j2
global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:

  - job_name: 'k8s-nodes'
    static_configs:
      - targets:
        - '10.158.1.10:9100'
        - '10.158.1.11:9100'
        - '10.158.1.12:9100'
        - '10.158.1.13:9100'
        - '10.158.1.14:9100'
        - '10.158.1.15:9100'

  - job_name: 'nfs-nodes'
    static_configs:
      - targets:
          - '10.158.1.40:9100'

  - job_name: 'minio-nodes'
    static_configs:
      - targets:
        - '10.158.1.20:9100'

  - job_name: minio-metrics
    metrics_path: /minio/v2/metrics/bucket
    bearer_token: eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJwcm9tZXRoZXVzIiwic3ViIjoiYWRtaW4iLCJleHAiOjQ5MjMxOTg5NjB9.KefE8cccDt1dhnJeF8L1c08Hl4lxVcMmWZ4YxRBv6AyTdyRAP8b25o8H5LDy9OVLKM4EMPp7fDHu5aAyc_QiXg
    scheme: http
    static_configs:
      - targets: [ '10.158.1.20:9000' ]

  - job_name: 'kube-state-metrics'
    static_configs:
      - targets:
          - '10.158.1.10:30880'
    relabel_configs:
      - source_labels: [ __address__ ]
        target_label: instance
        replacement: 'k8s-cluster'