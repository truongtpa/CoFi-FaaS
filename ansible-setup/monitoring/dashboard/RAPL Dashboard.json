        {
          "datasource": {
  "type": "influxdb",
  "uid": "${datasource}"
},
          "query": "cpu = from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"powerstat_package\")\n  |> filter(fn: (r) => r._field == \"current_power_consumption_watts\")\n  |> group()\n  |> aggregateWindow(every: 1s, fn: mean, createEmpty: false)\n  |> sum()\n\ndram = from(bucket: \"metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"powerstat_package\")\n  |> filter(fn: (r) => r._field == \"current_dram_power_consumption_watts\")\n  |> group()\n  |> aggregateWindow(every: 1s, fn: mean, createEmpty: false)\n  |> sum()\n\nunion(tables: [cpu, dram])\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({ r with _value: r._value / 3600000.0 }))",
          "refId": "A"
        }
      ],
      "title": "Total Node Energy in Time Range",
      "type": "stat"
    }
  ],
